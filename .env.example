# ====================================================================
# ObraHub - Variáveis de Ambiente
# ====================================================================

# Conexão PostgreSQL (Neon Database)
DATABASE_URL="postgresql://usuario:senha@ep-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@ep.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Acesso direto pelo Frontend (Vite)
VITE_DATABASE_URL="postgresql://usuario:senha@ep-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Branch do Neon
NEON_BRANCH=production

# (Opcional) Firebase Storage para comprovantes e fotos em nuvem
# Se não configurado, o app utiliza compressão Canvas automática e persistência otimizada no banco.
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN="obrahub-app.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="obrahub-app"
# VITE_FIREBASE_STORAGE_BUCKET="obrahub-app.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""

# Gemini API (Google AI Studio) - Leitura inteligente de comprovantes e transcrição/resumo de diários
# Obtenha uma chave gratuita em: https://aistudio.google.com/
VITE_GEMINI_API_KEY=""
